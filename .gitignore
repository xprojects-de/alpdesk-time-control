/Backend/database/
/Backend/build/
/Backend/.gradle
/Backend/dist/
/Frontend/.angular
/Frontend/dist
/Frontend/node_modules

# e2e-tests: generated per-run artifacts (state files, PDFs, CSV exports) - each suite
# writes these under its own results/ subfolder instead of the suite dir itself
/e2e-tests/*/results/

# e2e-tests: real race data. The suites run on the synthetic fixtures they ship with; a real
# event's exports (participant lists, results, printed rankings) hold names, birth years and clubs
# of real - often underage - participants and must never be committed. Keep them here and point
# the suite at them with KONDI_DATA_DIR, or keep them outside the repository entirely.
/e2e-tests/*/local-data/

# Python bytecode cache, regenerated on every e2e run
__pycache__/
*.pyc

# JetBrains per-user IDE state: local file paths, open editors, run configurations.
# The shared project files (misc.xml, modules.xml, vcs.xml, *.iml) stay tracked.
/.idea/workspace.xml

.DS_Store
