# ---------------------------------------------------------------------------
# Personenbezogene Daten
#
# Der wichtigste Block. Echte Renndaten - Teilnehmerlisten, Ergebnisse, Datenbanken,
# exportierte Wertungen - enthalten Namen, Jahrgaenge und Vereine meist minderjaehriger
# Teilnehmer. Was einmal committet wurde, bleibt in der Historie, auch wenn die Datei
# spaeter geloescht wird. Die Tests laufen deshalb auf synthetischen Demodaten; echte
# Daten gehoeren nach local-data/ oder ganz ausserhalb des Repos.
# Siehe docs/datenschutz.md.
# ---------------------------------------------------------------------------

# SQLite-Datenbanken samt WAL-Dateien - an jeder Stelle im Baum, nicht nur im
# Standard-Datenverzeichnis: eine zum Debuggen hereinkopierte Produktionsdatenbank
# waere der folgenschwerste Fehler, den man hier machen kann.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/Backend/database/

# Echte Renndaten fuer die e2e-Suites. Die Suites finden sie ueber eine
# Umgebungsvariable (z.B. KONDI_DATA_DIR), siehe das README der jeweiligen Suite.
local-data/

# Generierte Artefakte der e2e-Laeufe (Zustandsdateien, PDFs, CSV-Exporte). Jede Suite
# schreibt sie in ihren eigenen results/-Unterordner.
/e2e-tests/*/results/

# Git-Bundles sind vollstaendige Repository-Kopien - typischerweise Sicherungen vor
# einem Historien-Umbau, und damit potenziell voll mit allem, was man gerade entfernt.
*.bundle

# ---------------------------------------------------------------------------
# Build-Ergebnisse
#
# Dazu gehoert auch das gebaute Frontend unter Backend/src/main/resources/public: es
# entsteht per `npm run deploy` + `./gradlew copyFrontend`, und die GitHub-Workflows,
# die ein ausgeliefertes Jar bauen, erzeugen es selbst (build-installers.yml).
# ---------------------------------------------------------------------------
/Backend/build/
/Backend/src/main/resources/public/
/Backend/.gradle/
/Backend/dist/
/Frontend/.angular/
/Frontend/dist/
/Frontend/coverage/

# npm-Abhaengigkeiten an jeder Stelle im Baum - ausser dem Frontend hat auch
# docs/screenshots/ welche.
node_modules/
/build/
/.gradle/
out/

# ---------------------------------------------------------------------------
# IDE und Editor
#
# .idea/ ist bewusst komplett ausgenommen: Die Dateien sind rechnerspezifisch (sie
# verweisen auf lokale SDK-Namen wie "corretto-25", die es anderswo nicht gibt), und
# eine eingecheckte Konfiguration veraltet unbemerkt - die hier zuletzt versionierte
# stand noch auf JDK 21, obwohl das Projekt Java 25 braucht.
# ---------------------------------------------------------------------------
.idea/
*.iml
.vscode/
*~
*.swp
*.swo

# ---------------------------------------------------------------------------
# Werkzeuge
# ---------------------------------------------------------------------------

# Lokale Claude-Code-Einstellungen: enthalten die Berechtigungen des jeweiligen
# Entwicklers, nicht die des Projekts.
.claude/settings.local.json

# Python-Bytecode und virtuelle Umgebungen, die bei den e2e-Skripten entstehen koennen.
__pycache__/
*.pyc
.venv/
venv/

# Logdateien
*.log

# ---------------------------------------------------------------------------
# Betriebssystem
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini
