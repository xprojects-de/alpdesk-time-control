<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- Simplified production format: timestamp + message only -->
        <encoder>
            <pattern>%d{HH:mm:ss} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Feeds the desktop status window's inline log view - see SwingLogAppender. -->
    <appender name="SWING" class="x.timecontrol.util.SwingLogAppender" />

    <root level="info">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="SWING" />
    </root>
</configuration>

